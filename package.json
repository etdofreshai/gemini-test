{
  "name": "gemini-image-gen",
  "version": "2.0.0",
  "description": "Gemini image generation via web API",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,client -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "lint": "eslint src/server",
    "lint:fix": "eslint src/server --fix",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "gemini-watermark-remover": "file:../gemini-watermark-remover",
    "mime-types": "^3.0.2",
    "multer": "^1.4.5-lts.2",
    "sharp": "^0.34.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/express": "^5.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.15",
    "@types/ws": "^8.5.10",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.3",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.59.0"
  }
}
